  "modals": {
    "aboutData": {
      "title": "About the Data",
      "intro": "Birth probabilities are estimates calculated based on available data on annual births per country.",
      "methodology": "Methodology",
      "methodologyText": "The probability of being born in a given country is calculated as the proportion of that country's estimated annual births compared to the world total. We use approximate data from the World Bank and the UN (World Population Prospects). Values are estimates and may not reflect the most recent statistics.",
      "sensitivity": "Note on political sensitivity",
      "sensitivityText": "Borders, territories, and country recognition are politically sensitive issues. The inclusion of a territory in this game serves educational and geographical purposes and does not constitute a political stance. The data is simplified for an entertainment game.",
