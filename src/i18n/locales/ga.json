    "step1": {
      "title": "👋 Fáilte go WorldDex!",
      "desc": "Anseo baileoidh tú gach tír ar domhan trí tharraingtí atá bunaithe ar an bhfíor-ráta breithe domhanda. A ligean ar a fheiceáil conas a oibríonn sé?"
    },
    "step2": {
      "title": "🎲 Scrollaigh Timpeall an Domhain",
      "desc": "Cliceáil an cnaipe seo (nó brúigh Space) chun casadh. Tá an dóchúlacht go dtiocfaidh tú i dtír <b>go díreach mar a chéile leis an dóchúlacht go mbeirfear ann</b> sa saol fíor. Na breitheanna níos mó, is coitianta!"
    },
    "step3": {
      "title": "🗺️ Do Léarscáil",
      "desc": "Aon uair a scaoilfidh tú tír nua, déanfar é a phéinteáil ar an léarscáil le dath a thearc (Coiteann, Neamhchoitianta, Neamhchoitianta, Epic nó Finscéalach)."
    },
    "step4": {
      "title": "💖 Córas trua",
      "desc": "Gach uair a fhaigheann tú dúblach, téann do bharra ádh suas. Nuair a shroicheann tú an t-uasmhéid, tá <b>100% ráthaithe</b> don chéad casadh eile</b> a bheith ina tír nach bhfuil agat fós!"
    },
    "step5": {
      "title": "🛒 Siopa & Geilleagar",
      "desc": "Ná bí buartha faoi dúblaigh. Tugann gach tír arís agus arís eile <b>boinn</b> duit (ag brath ar a ganntanas). Is féidir leat boinn a úsáid sa Store seo chun <b>tíortha atá ar iarraidh a cheannach</b> nó <b>Uasghrádú</b> (cosúil le Autoclicker nó iolraitheoirí)."
    },
    "step6": {
      "title": "📚 Do Bhailiúchán",
      "desc": "Sa chluaisín seo feiceann tú na tíortha go léir atá glactha agat cheana féin agus cé mhéad atá fágtha agat. Is féidir leat cliceáil orthu chun sonraí agus fiosrachtaí a fheiceáil."
    },
    "step7": {
      "title": "🏆 Éachtaí",
      "desc": "Comhlánaigh ilchríocha, foirm grúpaí de thíortha ar leith (amhail an CPLP nó an tAontas Eorpach) agus bain amach spriocanna chun na héachtaí uathúla seo a dhíghlasáil."
    },
    "step8": {
      "title": "🌍 Réidh le himirt!",
      "desc": "Anois tá sé suas duit! Ádh mór ar do thuras chun an domhan ar fad a dhíghlasáil, breith amháin ag an am."
    }
