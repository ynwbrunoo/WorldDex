  "pity": {
    "title": "Akumulované štěstí",
    "guaranteedTitle": "Nová země zaručena!",
    "ready": "Další hod bude kouzelný!"
  },
  "tour": {
    "skip": "Přeskočit výukový program",
    "next": "Další ➔",
    "prev": "← Předchozí",
    "done": "Dokončete ✓",
    "progress": "Krok {{current}} z {{total}}",
    "step1": {
      "title": "👋 Vítejte na WorldDex!",
      "desc": "Zde budete sbírat všechny země světa prostřednictvím losování na základě skutečné globální porodnosti. Podívejme se, jak to funguje?"
    },
    "step2": {
      "title": "🎲 Přejděte kolem světa",
      "desc": "Kliknutím na toto tlačítko (nebo stisknutím mezerníku) se roztočí. Pravděpodobnost přistání v zemi je <b>přesně stejná jako pravděpodobnost, že se tam narodíte</b> v reálném světě. Čím více porodů, tím častější!"
    },
    "step3": {
      "title": "🗺️ Vaše mapa",
      "desc": "Kdykoli odemknete novou zemi, bude na mapě vybarvena barvou své vzácnosti (běžná, neobvyklá, vzácná, epická nebo legendární)."
    },
    "step4": {
      "title": "💖 Systém lítosti",
      "desc": "Pokaždé, když získáte duplikát, váš pruh štěstí se zvýší. Jakmile dosáhnete maxima, další roztočení je <b>100% zaručeno</b>, že to bude země, kterou ještě nemáte!"
    },
    "step5": {
      "title": "🛒 Obchod a ekonomika",
      "desc": "Nedělejte si starosti s duplikáty. Každá opakovaná země vám dá <b>mince</b> (v závislosti na její vzácnosti). Coiny v tomto obchodě můžete použít k <b>nákupu chybějících zemí</b> nebo k <b>upgradům</b> (jako je Autoclicker nebo multiplikátory)."
    },
    "step6": {
      "title": "📚 Vaše sbírka",
      "desc": "Na této záložce vidíte všechny země, které jste již obsadili, a kolik jich ještě zbývá. Kliknutím na ně zobrazíte podrobnosti a zajímavosti."
    },
    "step7": {
      "title": "🏆 Úspěchy",
      "desc": "Dokončete kontinenty, utvořte skupiny konkrétních zemí (jako je CPLP nebo Evropská unie) a dosáhněte cílů, abyste odemkli tyto jedinečné úspěchy."
    },
    "step8": {
      "title": "🌍 Připraveno ke hře!",
      "desc": "Teď je to na vás! Hodně štěstí na vaší cestě k odemknutí celého světa, jedno narození po druhém."
    }
  }
