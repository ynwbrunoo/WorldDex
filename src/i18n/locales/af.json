  "pity": {
    "title": "Opgehoopte geluk",
    "guaranteedTitle": "Nuwe land gewaarborg!",
    "ready": "Die volgende rol gaan magies wees!"
  },
  "tour": {
    "skip": "Slaan Tutoriaal oor",
    "next": "Volgende ➔",
    "prev": "← Vorige",
    "done": "Voltooi ✓",
    "progress": "Stap {{current}} van {{total}}",
    "step1": {
      "title": "👋 Welkom by WorldDex!",
      "desc": "Hier sal jy alle lande in die wêreld versamel deur middel van trekkings gebaseer op die ware globale geboortesyfer. Kom ons kyk hoe dit werk?"
    },
    "step2": {
      "title": "🎲 Blaai om die wêreld",
      "desc": "Klik hierdie knoppie (of druk spasie) om te draai. Die waarskynlikheid om op 'n land te land is <b>presies dieselfde as die waarskynlikheid om daar gebore te word</b> in die regte wêreld. Hoe meer geboortes, hoe meer algemeen!"
    },
    "step3": {
      "title": "🗺️ Jou kaart",
      "desc": "Wanneer jy 'n nuwe land ontsluit, sal dit op die kaart geverf word met die kleur van sy skaarsheid (Algemeen, Ongewoon, Skaars, Epos of Legendaries)."
    },
    "step4": {
      "title": "💖 Jammerstelsel",
      "desc": "Elke keer as jy 'n duplikaat kry, gaan jou gelukbalk op. Sodra jy die maksimum bereik het, is die volgende draai <b>100% gewaarborg</b> om 'n land te wees wat jy nog nie het nie!"
    },
    "step5": {
      "title": "🛒 Winkel en ekonomie",
      "desc": "Moenie bekommerd wees oor duplikate nie. Elke herhaalde land gee vir jou <b>munte</b> (na gelang van die rariteit daarvan). Jy kan munte in hierdie winkel gebruik om <b>ontbrekende lande te koop</b> of <b>opgraderings</b> (soos outoklikker of vermenigvuldigers)."
    },
    "step6": {
      "title": "📚 Jou versameling",
      "desc": "In hierdie oortjie kan jy al die lande sien wat jy reeds geneem het en hoeveel jy oor het. Jy kan op hulle klik om besonderhede en nuuskierigheid te sien."
    },
    "step7": {
      "title": "🏆 Prestasies",
      "desc": "Voltooi vastelande, vorm groepe van spesifieke lande (soos die CPLP of Europese Unie) en bereik doelwitte om hierdie unieke prestasies te ontsluit."
    },
    "step8": {
      "title": "🌍 Gereed om te speel!",
      "desc": "Nou is dit aan jou! Sterkte op jou reis om die hele wêreld te ontsluit, een geboorte op 'n slag."
    }
  },
