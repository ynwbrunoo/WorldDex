    "progress": "الخطوة {{current}} من {{total}}",
    "step1": {
      "title": "👋 مرحبًا بك في WorldDex!",
      "desc": "هنا سوف تقوم بجمع كل دول العالم من خلال السحوبات على أساس معدل المواليد العالمي الحقيقي. دعونا نرى كيف يعمل؟"
    },
    "step2": {
      "title": "🎲 قم بالتمرير حول العالم",
      "desc": "انقر فوق هذا الزر (أو اضغط على Space) للدوران. احتمال الهبوط في بلد ما هو <b>تمامًا نفس احتمال الميلاد هناك</b> في العالم الحقيقي. كلما زاد عدد الولادات، كلما زاد عددها!"
    },
    "step3": {
      "title": "🗺️ O Teu Mapa",
      "desc": "Sempre que desbloqueares um país novo, ele será pintado no mapa com a cor da sua raridade (Comum, Incomum, Raro, Épico ou Lendário)."
    },
    "step4": {
      "title": "💖 نظام الشفقة",
      "desc": "Cada vez que te calha um duplicado, a barra de sorte sobe. Quando chegar ao máximo, o próximo giro é <b>100% garantido</b> de ser um país que ainda não tens!"
    },
    "step5": {
      "title": "🛒 Loja & Economia",
      "desc": "Não te preocupes com os duplicados. Cada país repetido dá-te <b>moedas</b> (dependendo da sua raridade). Podes usar moedas nesta Loja para <b>comprar países em falta</b> ou <b>Upgrades</b> (como o Autoclicker ou multiplicadores)."
    },
    "step6": {
      "title": "📚 A Tua Coleção",
      "desc": "Nesta aba podes ver todos os países que já tiraste e quantos te faltam. Podes clicar neles para veres detalhes e curiosidades."
    },
    "step7": {
      "title": "🏆 Conquistas",
      "desc": "Completa continentes, forma grupos de países específicos (como a CPLP ou União Europeia) e alcança metas para desbloquear estas conquistas únicas."
    },
    "step8": {
      "title": "🌍 Pronto a Jogar!",
      "desc": "Agora é contigo! Boa sorte na tua jornada para desbloquear o mundo inteiro, um nascimento de cada vez."
    }
  }
