  "tour": {
    "skip": "Pular Tutorial",
    "next": "Avanti ➔",
    "prev": "← Anterior",
    "done": "Fine ✓",
    "progress": "Passaggio {{current}} di {{total}}",
    "step1": {
      "title": "👋 Benvenuto nel WorldDex!",
      "desc": "Aqui vais colecionar todos os países do mundo através de sorteios baseados na verdadeira taxa de natalidade global. Vamos ver como funciona?"
    },
    "step2": {
      "title": "🎲 Scorri il giro del mondo",
      "desc": "Clica neste botão (ou pressiona Espaço) para girares. A probabilidade de te calhar um país é <b>exatamente igual à probabilidade de nasceres lá</b> no mundo real. Quanto mais nascimentos, mais comum!"
    },
    "step3": {
      "title": "🗺️ La tua mappa",
      "desc": "Ogni volta che sblocchi un nuovo paese, verrà dipinto sulla mappa con il colore della sua rarità (Comune, Non comune, Raro, Epico o Leggendario)."
    },
    "step4": {
      "title": "💖 Sistema pietà",
      "desc": "Ogni volta che ottieni un duplicato, la tua barra della fortuna sale. Una volta raggiunto il massimo, il giro successivo è <b>garantito al 100%</b> per essere un paese che non hai ancora!"
    },
    "step5": {
      "title": "🛒 Negozio & Economia",
      "desc": "Non preoccuparti dei duplicati. Ogni paese ripetuto ti dà <b>monete</b> (a seconda della sua rarità). Puoi utilizzare le monete in questo Negozio per <b>acquistare paesi mancanti</b> o <b>Aggiornamenti</b> (come Autoclicker o moltiplicatori)."
    },
    "step6": {
      "title": "📚 La tua collezione",
      "desc": "In questa scheda puoi vedere tutti i paesi che hai già preso e quanti ne hai lasciati. Potete cliccarci sopra per vedere dettagli e curiosità."
    },
    "step7": {
      "title": "🏆 Risultati",
      "desc": "Completa continenti, forma gruppi di paesi specifici (come CPLP o Unione Europea) e raggiungi obiettivi per sbloccare questi risultati unici."
    },
    "step8": {
      "title": "🌍 Pronto per giocare!",
      "desc": "Ora tocca a te! Buona fortuna nel tuo viaggio per sbloccare il mondo intero, una nascita alla volta."
    }
  },
