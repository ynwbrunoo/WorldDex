  "pity": {
    "title": "Naipon na Suwerte",
    "guaranteedTitle": "Garantisadong Bagong Bansa!",
    "ready": "Ang susunod na roll ay magiging mahiwagang!"
  },
  "tour": {
    "skip": "Pular Tutorial",
    "next": "Próximo ➔",
    "prev": "← Anterior",
    "done": "Terminar ✓",
    "progress": "Passo {{current}} de {{total}}",
    "step1": {
      "title": "👋 Bem-vindo ao WorldDex!",
      "desc": "Aqui vais colecionar todos os países do mundo através de sorteios baseados na verdadeira taxa de natalidade global. Vamos ver como funciona?"
    },
    "step2": {
      "title": "🎲 Rolar Pelo Mundo",
      "desc": "Clica neste botão (ou pressiona Espaço) para girares. A probabilidade de te calhar um país é <b>exatamente igual à probabilidade de nasceres lá</b> no mundo real. Quanto mais nascimentos, mais comum!"
    },
    "step3": {
      "title": "🗺️ O Teu Mapa",
      "desc": "Sa tuwing mag-a-unlock ka ng isang bagong bansa, ito ay ipininta sa mapa na may kulay na pambihira nito (Karaniwan, Hindi Karaniwan, Bihira, Epiko o Maalamat)."
    },
    "step4": {
      "title": "💖 Sistema de Pity",
      "desc": "Sa tuwing makakakuha ka ng duplicate, tumataas ang iyong luck bar. Kapag naabot mo na ang maximum, ang susunod na pag-ikot ay <b>100% garantisadong</b> na maging isang bansang wala ka pa!"
    },
    "step5": {
      "title": "🛒 Tindahan at Ekonomiya",
      "desc": "Huwag mag-alala tungkol sa mga duplicate. Ang bawat paulit-ulit na bansa ay nagbibigay sa iyo ng <b>mga barya</b> (depende sa pambihira nito). Maaari kang gumamit ng mga barya sa Store na ito upang <b>bumili ng mga nawawalang bansa</b> o <b>Mga Pag-upgrade</b> (tulad ng Autoclicker o mga multiplier)."
    },
    "step6": {
      "title": "📚 Iyong Koleksyon",
      "desc": "Sa tab na ito makikita mo ang lahat ng mga bansang nakuha mo na at kung ilan ang natitira mo. Maaari mong i-click ang mga ito upang makita ang mga detalye at mga kuryusidad."
    },
    "step7": {
      "title": "🏆 Mga nakamit",
      "desc": "Kumpletuhin ang mga kontinente, bumuo ng mga grupo ng mga partikular na bansa (tulad ng CPLP o European Union) at makamit ang mga layunin upang i-unlock ang mga natatanging tagumpay na ito."
    },
    "step8": {
      "title": "🌍 Handa nang Maglaro!",
      "desc": "Ngayon ikaw na ang bahala! Good luck sa iyong paglalakbay upang i-unlock ang buong mundo, isang kapanganakan sa isang pagkakataon."
    }
  }
