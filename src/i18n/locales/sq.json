  "tour": {
    "skip": "Kapërceni tutorialin",
    "next": "Tjetra ➔",
    "prev": "⬅ E mëparshme",
    "done": "Përfundoni ✓",
    "progress": "Hapi {{current}} nga {{total}}",
    "step1": {
      "title": "👋 Mirë se vini në WorldDex!",
      "desc": "Këtu do të grumbulloni të gjitha vendet në botë përmes shorteve bazuar në shkallën e vërtetë të lindjeve globale. Le të shohim se si funksionon?"
    },
    "step2": {
      "title": "🎲 Lëviz nëpër botë",
      "desc": "Klikoni këtë buton (ose shtypni Space) për të rrotulluar. Probabiliteti për të zbritur në një vend është <b>saktësisht i njëjtë me probabilitetin për të lindur atje</b> në botën reale. Sa më shumë lindje, aq më të zakonshme!"
    },
    "step3": {
      "title": "🗺️ Harta juaj",
      "desc": "Sa herë që zhbllokoni një vend të ri, ai do të pikturohet në hartë me ngjyrën e rrallë (të zakonshme, të pazakonta, të rralla, epike ose legjendare)."
    },
    "step4": {
      "title": "💖 Sistemi i keqardhjes",
      "desc": "Sa herë që merrni një kopje, shiriti juaj i fatit rritet. Pasi të keni arritur maksimumin, rrotullimi tjetër është <b>100% i garantuar</b> të jetë një vend që nuk e keni ende!"
    },
    "step5": {
      "title": "🛒 Dyqan & Ekonomi",
      "desc": "Mos u shqetësoni për dublikatat. Çdo shtet i përsëritur ju jep <b>monedha</b> (në varësi të rrallësisë së tij). Ju mund të përdorni monedha në këtë Dyqan për <b>blerë shtete që mungojnë</b> ose <b>Përmirësime</b> (si Autoclicker ose shumëzues)."
    },
    "step6": {
      "title": "📚 Koleksioni juaj",
      "desc": "Në këtë skedë mund të shihni të gjitha vendet që keni marrë tashmë dhe sa keni lënë. Mund të klikoni mbi to për të parë detajet dhe kuriozitetet."
    },
    "step7": {
      "title": "🏆 Arritjet",
      "desc": "Plotësoni kontinente, formoni grupe vendesh specifike (si CPLP ose Bashkimi Evropian) dhe arrini qëllimet për të zhbllokuar këto arritje unike."
    },
    "step8": {
      "title": "🌍 Gati për të luajtur!",
      "desc": "Tani varet nga ju! Fat i mirë në udhëtimin tuaj për të zhbllokuar të gjithë botën, një lindje në një kohë."
    }
  }
