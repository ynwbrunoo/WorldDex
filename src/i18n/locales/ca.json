  "pity": {
    "title": "Sort acumulada",
    "guaranteedTitle": "Nou país garantit!",
    "ready": "La propera tirada serà màgica!"
  },
  "tour": {
    "skip": "Omet el tutorial",
    "next": "Següent ➔",
    "prev": "← Anterior",
    "done": "Acabat ✓",
    "progress": "Pas {{current}} de {{total}}",
    "step1": {
      "title": "👋 Benvingut a WorldDex!",
      "desc": "Aquí recollireu tots els països del món mitjançant sortejos basats en la veritable taxa de natalitat global. A veure com funciona?"
    },
    "step2": {
      "title": "🎲 Fes una volta pel món",
      "desc": "Feu clic a aquest botó (o premeu espai) per girar. La probabilitat d'aterrar a un país és <b>exactament la mateixa que la probabilitat de néixer-hi</b> al món real. Com més naixements, més comú!"
    },
    "step3": {
      "title": "🗺️ El teu mapa",
      "desc": "Sempre que desbloquegeu un país nou, es pintarà al mapa amb el color de la seva raresa (comú, poc comú, rar, èpic o llegendari)."
    },
    "step4": {
      "title": "💖 Sistema de llàstima",
      "desc": "Cada vegada que obteniu un duplicat, la vostra barra de sort augmenta. Un cop arribeu al màxim, el següent gir està <b>100% garantit</b> que serà un país que encara no teniu!"
    },
    "step5": {
      "title": "🛒 Botiga i Economia",
      "desc": "No us preocupeu pels duplicats. Cada país repetit us ofereix <b>monedes</b> (segons la seva raresa). Podeu utilitzar monedes en aquesta botiga per <b>comprar països que falten</b> o <b>Actualitzacions</b> (com ara Autoclicker o multiplicadors)."
    },
    "step6": {
      "title": "📚 La teva col·lecció",
      "desc": "En aquesta pestanya podeu veure tots els països que ja heu pres i quants us queden. Podeu clicar-hi per veure detalls i curiositats."
    },
    "step7": {
      "title": "🏆 Assoliments",
      "desc": "Completa continents, forma grups de països específics (com la CPLP o la Unió Europea) i assoleix objectius per desbloquejar aquests assoliments únics."
    },
    "step8": {
      "title": "🌍 A punt per jugar!",
      "desc": "Ara et toca a tu! Molta sort en el teu viatge per desbloquejar el món sencer, un naixement a la vegada."
    }
  },
