  "tour": {
    "skip": "Lewati Tutorial",
    "next": "Selanjutnya ➔",
    "prev": "← Sebelumnya",
    "done": "Selesai ✓",
    "progress": "Langkah {{current}} dari {{total}}",
    "step1": {
      "title": "👋 Selamat datang di WorldDex!",
      "desc": "Di sini Anda akan mengumpulkan semua negara di dunia melalui pengundian berdasarkan angka kelahiran global sebenarnya. Mari kita lihat cara kerjanya?"
    },
    "step2": {
      "title": "🎲 Gulir ke Seluruh Dunia",
      "desc": "Klik tombol ini (atau tekan Spasi) untuk memutar. Peluang untuk mendarat di suatu negara <b>sama persis dengan peluang untuk dilahirkan di sana</b> di dunia nyata. Semakin banyak kelahiran, semakin sering terjadi!"
    },
    "step3": {
      "title": "🗺️ Peta Anda",
      "desc": "Setiap kali Anda membuka kunci negara baru, negara tersebut akan dicat di peta dengan warna kelangkaannya (Umum, Jarang, Langka, Epik, atau Legendaris)."
    },
    "step4": {
      "title": "💖 Sistem Kasihan",
      "desc": "Setiap kali Anda mendapatkan duplikat, bilah keberuntungan Anda naik. Setelah Anda mencapai jumlah maksimum, putaran berikutnya <b>dijamin 100%</b> menjadi negara yang belum Anda miliki!"
    },
    "step5": {
      "title": "🛒 Toko & Ekonomi",
      "desc": "Jangan khawatir tentang duplikat. Setiap negara yang berulang memberi Anda <b>koin</b> (tergantung pada kelangkaannya). Anda dapat menggunakan koin di Toko ini untuk <b>membeli negara yang hilang</b> atau <b>Peningkatan</b> (seperti Autoclicker atau pengganda)."
    },
    "step6": {
      "title": "📚 Koleksi Anda",
      "desc": "Di tab ini Anda dapat melihat semua negara yang telah Anda kunjungi dan berapa banyak yang tersisa. Anda dapat mengkliknya untuk melihat detail dan keingintahuan."
    },
    "step7": {
      "title": "🏆 Prestasi",
      "desc": "Selesaikan benua, bentuk kelompok negara tertentu (seperti CPLP atau Uni Eropa) dan raih tujuan untuk membuka pencapaian unik ini."
    },
    "step8": {
      "title": "🌍 Siap Bermain!",
      "desc": "Sekarang terserah Anda! Semoga beruntung dalam perjalanan Anda untuk membuka seluruh dunia, satu demi satu kelahiran."
    }
