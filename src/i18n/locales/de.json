  "pity": {
    "title": "Angesammeltes Glück",
    "guaranteedTitle": "Neues Land Garantiert!",
    "ready": "Der nächste Wurf wird magisch!"
  },
  "tour": {
    "skip": "Tutorial überspringen",
    "next": "Weiter ➔",
    "prev": "← Zurück",
    "done": "Beenden ✓",
    "progress": "Schritt {{current}} von {{total}}",
    "step1": {
      "title": "👋 Willkommen bei WorldDex!",
      "desc": "Hier sammeln Sie alle Länder der Welt durch Verlosungen basierend auf der tatsächlichen globalen Geburtenrate. Mal sehen, wie es funktioniert?"
    },
    "step2": {
      "title": "🎲 Scrollen Sie um die Welt",
      "desc": "Klicken Sie auf diese Schaltfläche (oder drücken Sie die Leertaste), um zu drehen. Die Wahrscheinlichkeit, in einem Land zu landen, ist <b>genau die gleiche wie die Wahrscheinlichkeit, dort in der realen Welt geboren zu werden</b>. Je mehr Geburten, desto häufiger!"
    },
    "step3": {
      "title": "🗺️ Deine Karte",
      "desc": "Immer wenn Sie ein neues Land freischalten, wird es in der Farbe seiner Seltenheit (häufig, ungewöhnlich, selten, episch oder legendär) auf der Karte angezeigt."
    },
    "step4": {
      "title": "💖 Mitleidssystem",
      "desc": "Jedes Mal, wenn Sie ein Duplikat erhalten, steigt Ihr Glücksbalken. Sobald Sie das Maximum erreicht haben, ist die nächste Drehung <b>100 % garantiert</b> in einem Land, das Sie noch nicht haben!"
    },
    "step5": {
      "title": "🛒 Shop & Wirtschaft",
      "desc": "Machen Sie sich keine Sorgen über Duplikate. Jedes wiederholte Land gibt Ihnen <b>Münzen</b> (abhängig von seiner Seltenheit). Sie können Münzen in diesem Shop verwenden, um <b>fehlende Länder</b> oder <b>Upgrades</b> (wie Autoclicker oder Multiplikatoren) zu kaufen."
    },
    "step6": {
      "title": "📚 Deine Sammlung",
      "desc": "Auf dieser Registerkarte sehen Sie alle Länder, die Sie bereits besucht haben und wie viele Sie noch verlassen haben. Sie können darauf klicken, um Details und Kuriositäten anzuzeigen."
    },
    "step7": {
      "title": "🏆 Erfolge",
      "desc": "Schließe Kontinente ab, bilde Gruppen bestimmter Länder (wie die CPLP oder die Europäische Union) und erreiche Ziele, um diese einzigartigen Erfolge freizuschalten."
    },
    "step8": {
      "title": "🌍 Bereit zum Spielen!",
      "desc": "Jetzt liegt es an Ihnen! Viel Glück auf Ihrer Reise, die ganze Welt zu erschließen, eine Geburt nach der anderen."
    }
  },
