  "pity": {
    "title": "Noroc acumulat",
    "guaranteedTitle": "Noua tara garantata!",
    "ready": "Următoarea rolă va fi magică!"
  },
  "tour": {
    "skip": "Omite tutorialul",
    "next": "Următorul ➔",
    "prev": "← Anterior",
    "done": "Terminare ✓",
    "progress": "Pasul {{current}} din {{total}}",
    "step1": {
      "title": "👋 Bine ați venit la WorldDex!",
      "desc": "Aici veți colecta toate țările din lume prin extrageri bazate pe rata natalității globală reală. Să vedem cum funcționează?"
    },
    "step2": {
      "title": "🎲 Derulați în jurul lumii",
      "desc": "Faceți clic pe acest buton (sau apăsați pe Space) pentru a roti. Probabilitatea de a ateriza într-o țară este <b>exact aceeași cu probabilitatea de a te naște acolo</b> în lumea reală. Cu cât sunt mai multe nașteri, cu atât mai frecvente!"
    },
    "step3": {
      "title": "🗺️ Harta ta",
      "desc": "Ori de câte ori deblocați o țară nouă, aceasta va fi pictată pe hartă cu culoarea rarității acesteia (Comun, Neobișnuit, Rar, Epic sau Legendar)."
    },
    "step4": {
      "title": "💖 Sistemul Pity",
      "desc": "De fiecare dată când obțineți un duplicat, bara norocului crește. Odată ce atingeți maximul, următoarea rotire este <b>100% garantată</b> că va fi o țară pe care nu o aveți încă!"
    },
    "step5": {
      "title": "🛒 Magazin și economie",
      "desc": "Nu vă faceți griji pentru duplicate. Fiecare țară repetată vă oferă <b>monede</b> (în funcție de raritatea acesteia). Puteți folosi monede în acest Magazin pentru a <b>cumpăra țări lipsă</b> sau <b>Actualizări</b> (cum ar fi Autoclicker sau multiplicatori)."
    },
    "step6": {
      "title": "📚 Colecția ta",
      "desc": "În această filă puteți vedea toate țările pe care le-ați luat deja și câte ați mai rămas. Puteți da clic pe ele pentru a vedea detalii și curiozități."
    },
    "step7": {
      "title": "🏆 Realizări",
      "desc": "Completați continente, formați grupuri de țări specifice (cum ar fi CPLP sau Uniunea Europeană) și atingeți obiectivele pentru a debloca aceste realizări unice."
    },
    "step8": {
      "title": "🌍 Gata de joc!",
      "desc": "Acum depinde de tine! Mult succes în călătoria ta pentru a debloca întreaga lume, câte o naștere pe rând."
    }
  }
