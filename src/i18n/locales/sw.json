      "desc": "Aqui vais colecionar todos os países do mundo através de sorteios baseados na verdadeira taxa de natalidade global. Vamos ver como funciona?"
    },
    "step2": {
      "title": "🎲 Tembeza Ulimwenguni Pote",
      "desc": "Bofya kitufe hiki (au bonyeza Space) ili kusogeza. Uwezekano wa kutua kwenye nchi <b>ni sawa kabisa na uwezekano wa kuzaliwa huko</b> katika ulimwengu halisi. Kuzaliwa zaidi, zaidi ya kawaida!"
    },
    "step3": {
      "title": "🗺️ Ramani yako",
      "desc": "Wakati wowote unapofungua nchi mpya, itapakwa rangi kwenye ramani na rangi ya adimu yake (Kawaida, Isiyo Kawaida, Nadra, Epic au Hadithi)."
    },
    "step4": {
      "title": "💖 Mfumo wa Huruma",
      "desc": "Kila mara unapopata nakala, upau wako wa bahati hupanda. Ukifika kiwango cha juu zaidi, mzunguko unaofuata <b>umehakikishiwa 100%</b> kuwa nchi ambayo bado huna!"
    },
    "step5": {
      "title": "🛒 Duka na Uchumi",
      "desc": "Usijali kuhusu nakala. Kila nchi inayorudiwa hukupa <b>sarafu</b> (kulingana na uchache wake). Unaweza kutumia sarafu katika Duka hili <b>kununua nchi ambazo hazipo</b> au <b>Maboresho</b> (kama vile Autoclicker au vizidishi)."
    },
    "step6": {
      "title": "📚 Mkusanyiko Wako",
      "desc": "Katika kichupo hiki unaweza kuona nchi zote ambazo tayari umechukua na ni ngapi umesalia. Unaweza kubofya ili kuona maelezo na udadisi."
    },
    "step7": {
      "title": "🏆 Mafanikio",
      "desc": "Kamilisha mabara, huunda vikundi vya nchi mahususi (kama vile CPLP au Umoja wa Ulaya) na ufikie malengo ya kufungua mafanikio haya ya kipekee."
    },
    "step8": {
      "title": "🌍 Tayari Kucheza!",
      "desc": "Sasa ni juu yako! Bahati nzuri katika safari yako ya kufungua ulimwengu mzima, kuzaliwa mara moja."
    }
