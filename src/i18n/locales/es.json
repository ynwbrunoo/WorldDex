  "tour": {
    "skip": "Saltar tutorial",
    "next": "Siguiente ➔",
    "prev": "⬅ Anterior",
    "done": "Terminar ✓",
    "progress": "Paso {{current}} de {{total}}",
    "step1": {
      "title": "👋 ¡Bienvenido a WorldDex!",
      "desc": "Aquí recopilarás todos los países del mundo mediante sorteos basados ​​en la verdadera tasa de natalidad global. ¿Veamos cómo funciona?"
    },
    "step2": {
      "title": "🎲 Desplácese por el mundo",
      "desc": "Haga clic en este botón (o presione la barra espaciadora) para girar. La probabilidad de aterrizar en un país es <b>exactamente la misma que la probabilidad de nacer allí</b> en el mundo real. ¡Cuantos más nacimientos, más comunes!"
    },
    "step3": {
      "title": "🗺️ Tu mapa",
      "desc": "Cada vez que desbloqueas un nuevo país, se pintará en el mapa con el color de su rareza (Común, Poco común, Raro, Épico o Legendario)."
    },
    "step4": {
      "title": "💖 Sistema de lástima",
      "desc": "Cada vez que obtienes un duplicado, tu barra de suerte aumenta. Una vez que alcances el máximo, ¡el siguiente giro está <b>100 % garantizado</b> en un país que aún no tienes!"
    },
    "step5": {
      "title": "🛒 Tienda y economía",
      "desc": "No te preocupes por los duplicados. Cada país repetido te otorga <b>monedas</b> (dependiendo de su rareza). Puedes usar monedas en esta Tienda para <b>comprar países faltantes</b> o <b>actualizaciones</b> (como Autoclicker o multiplicadores)."
    },
    "step6": {
      "title": "📚 Tu colección",
      "desc": "En esta pestaña podrás ver todos los países que ya has tomado y cuántos te quedan. Puedes hacer clic en ellos para ver detalles y curiosidades."
    },
    "step7": {
      "title": "🏆 Logros",
      "desc": "Completa continentes, forma grupos de países específicos (como la CPLP o la Unión Europea) y alcanza objetivos para desbloquear estos logros únicos."
    },
    "step8": {
      "title": "🌍 ¡Listo para jugar!",
      "desc": "¡Ahora depende de ti! Buena suerte en tu viaje para desbloquear el mundo entero, un nacimiento a la vez."
    }
  }
