  "modals": {
    "aboutData": {
      "title": "Sobre os Dados",
      "intro": "As probabilidades de nascimento são estimativas calculadas com base nos dados disponíveis sobre nascimentos anuais por país.",
      "methodology": "Metodologia",
      "methodologyText": "A chance de nascer em um dado país é calculada como a proporção dos nascimentos anuais estimados desse país em relação ao total mundial. Utilizamos dados aproximados do Banco Mundial e da ONU (World Population Prospects). Os valores são estimativas e podem não refletir as estatísticas mais recentes.",
      "sensitivity": "Nota sobre sensibilidade política",
      "sensitivityText": "As fronteiras, os territórios e o reconhecimento dos países são questões politicamente sensíveis. A inclusão de um território neste jogo tem fins educativos e geográficos, e não constitui uma posição política. Os dados são simplificados para um jogo de entretenimento.",
      "updates": "Atualização dos dados",
      "updatesText": "Os dados demográficos mudam ao longo do tempo. Este projeto procura manter os dados razoavelmente atualizados, mas não garante precisão em tempo real.",
      "sources": "Fontes",
      "sourcesList": [
        "Banco Mundial — Indicadores de Desenvolvimento Mundial",
        "ONU — World Population Prospects 2022",
        "Natural Earth — Dados geográficos (domínio público)",
        "world-atlas (TopoJSON) — Dados do mapa"
      ],
      "close": "Fechar"
    },
    "privacy": {
      "title": "Privacidade e Termos",
      "project": "Este é um projeto gratuito, não comercial e de caráter educativo e lúdico.",
      "noData": "Nenhum dado pessoal é coletado.",
      "localStorage": "O seu progresso é salvo exclusivamente no armazenamento local (localStorage) do seu dispositivo. Nenhuma informação é enviada para servidores.",
      "noCookies": "Este jogo não utiliza cookies. Apenas o localStorage é utilizado para salvar suas preferências e progresso.",
      "noTracking": "Não existem sistemas de análise, rastreamento, publicidade ou serviços de terceiros.",
      "borders": "Os dados geográficos, demográficos e de fronteiras são estimativas e podem estar incompletos ou desatualizados. Este projeto não toma posição política sobre fronteiras, territórios ou reconhecimento de estados.",
