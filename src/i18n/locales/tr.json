  "pity": {
    "title": "Birikmiş Şans",
    "guaranteedTitle": "Yeni Ülke Garantili!",
    "ready": "Bir sonraki atış büyülü olacak!"
  },
  "tour": {
    "skip": "Eğiticiyi Atla",
    "next": "Sonraki ➔",
    "prev": "⬅ Önceki",
    "done": "Bitir ✓",
    "progress": "{{current}}. adım / {{total}}",
    "step1": {
      "title": "👋 WorldDex'e hoş geldiniz!",
      "desc": "Burada gerçek küresel doğum oranına dayalı çekilişlerle dünyadaki tüm ülkeleri toplayacaksınız. Bakalım nasıl çalışıyor?"
    },
    "step2": {
      "title": "🎲 Dünyayı Kaydırın",
      "desc": "Döndürmek için bu düğmeye tıklayın (veya Space tuşuna basın). Bir ülkeye varma olasılığı, gerçek dünyada <b>orada doğma olasılığıyla tamamen aynıdır</b>. Ne kadar çok doğum olursa, o kadar yaygın olur!"
    },
    "step3": {
      "title": "🗺️ Haritanız",
      "desc": "Yeni bir ülkenin kilidini açtığınızda, bu ülke haritada nadirliğinin rengiyle (Yaygın, Sıradışı, Nadir, Destansı veya Efsanevi) boyanacaktır."
    },
    "step4": {
      "title": "💖 Acıma Sistemi",
      "desc": "Her kopya aldığınızda şans çubuğunuz yükselir. Maksimum seviyeye ulaştığınızda, bir sonraki dönüşün henüz sahip olmadığınız bir ülke olması <b>%100 garantilidir</b>!"
    },
    "step5": {
      "title": "🛒 Mağaza ve Ekonomi",
      "desc": "Kopyalar konusunda endişelenmeyin. Tekrarlanan her ülke size <b>jeton</b> verir (nadirliğine bağlı olarak). Bu Mağazadaki paraları <b>eksik ülkeleri satın almak</b> veya <b>Yükseltmeler</b> (Otomatik Tıklayıcı veya çarpanlar gibi) için kullanabilirsiniz."
    },
    "step6": {
      "title": "📚 Koleksiyonunuz",
      "desc": "Bu sekmede halihazırda almış olduğunuz tüm ülkeleri ve kaç tane kaldığını görebilirsiniz. Detayları ve merak edilenleri görmek için üzerlerine tıklayabilirsiniz."
    },
    "step7": {
      "title": "🏆 Başarılar",
      "desc": "Kıtaları tamamlayın, belirli ülkelerden oluşan gruplar oluşturun (CPLP veya Avrupa Birliği gibi) ve bu benzersiz başarıların kilidini açmak için hedeflere ulaşın."
    },
    "step8": {
      "title": "🌍 Oynamaya Hazır!",
      "desc": "Artık karar size kalmış! Her seferinde bir doğum olmak üzere tüm dünyanın kilidini açma yolculuğunuzda iyi şanslar."
    }
  }
