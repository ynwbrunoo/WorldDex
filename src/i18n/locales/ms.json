  "pity": {
    "title": "Nasib Terkumpul",
    "guaranteedTitle": "Negara Baharu Dijamin!",
    "ready": "Gulungan seterusnya akan menjadi ajaib!"
  },
  "tour": {
    "skip": "Langkau Tutorial",
    "next": "Seterusnya ➔",
    "prev": "← Sebelumnya",
    "done": "Selesai ✓",
    "progress": "Langkah {{current}} daripada {{total}}",
    "step1": {
      "title": "👋 Selamat datang ke WorldDex!",
      "desc": "Di sini anda akan mengumpul semua negara di dunia melalui cabutan berdasarkan kadar kelahiran global sebenar. Mari lihat bagaimana ia berfungsi?"
    },
    "step2": {
      "title": "🎲 Tatal Seluruh Dunia",
      "desc": "Klik butang ini (atau tekan Space) untuk berputar. Kebarangkalian untuk mendarat di sesebuah negara adalah <b>tepat sama dengan kebarangkalian untuk dilahirkan di sana</b> di dunia nyata. Lebih banyak kelahiran, lebih biasa!"
    },
    "step3": {
      "title": "🗺️ Peta Anda",
      "desc": "Setiap kali anda membuka kunci negara baharu, ia akan dilukis pada peta dengan warna yang jarang berlaku (Biasa, Tidak Biasa, Jarang, Epik atau Legenda)."
    },
    "step4": {
      "title": "💖 Sistem Kesian",
      "desc": "Setiap kali anda mendapat pendua, bar nasib anda naik. Sebaik sahaja anda mencapai tahap maksimum, putaran seterusnya <b>100% dijamin</b> sebagai negara yang belum anda miliki!"
    },
    "step5": {
      "title": "🛒 Kedai & Ekonomi",
      "desc": "Jangan risau tentang pendua. Setiap negara berulang memberi anda <b>syiling</b> (bergantung pada kelazimannya). Anda boleh menggunakan syiling di Kedai ini untuk <b>membeli negara yang hilang</b> atau <b>Peningkatan</b> (seperti Autoklik atau pengganda)."
    },
    "step6": {
      "title": "📚 Koleksi Anda",
      "desc": "Dalam tab ini anda boleh melihat semua negara yang telah anda ambil dan berapa banyak yang anda tinggalkan. Anda boleh klik pada mereka untuk melihat butiran dan rasa ingin tahu."
    },
    "step7": {
      "title": "🏆 Pencapaian",
      "desc": "Lengkapkan benua, bentuk kumpulan negara tertentu (seperti CPLP atau Kesatuan Eropah) dan capai matlamat untuk membuka kunci pencapaian unik ini."
    },
    "step8": {
      "title": "🌍 Sedia untuk Bermain!",
      "desc": "Sekarang terpulang kepada anda! Semoga berjaya dalam perjalanan anda untuk membuka kunci seluruh dunia, satu kelahiran pada satu masa."
    }
  },
