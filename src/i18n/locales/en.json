    "step1": {
      "title": "👋 Bem-vindo ao WorldDex!",
      "desc": "Here you will collect all countries in the world through draws based on the true global birth rate. Let's see how it works?"
    },
    "step2": {
      "title": "🎲 Scroll Around the World",
      "desc": "Click this button (or press Space) to spin. The probability of landing on a country is <b>exactly the same as the probability of being born there</b> in the real world. The more births, the more common!"
    },
    "step3": {
      "title": "🗺️ Your Map",
      "desc": "Whenever you unlock a new country, it will be painted on the map with the color of its rarity (Common, Uncommon, Rare, Epic or Legendary)."
    },
    "step4": {
      "title": "💖 Pity System",
      "desc": "Every time you get a duplicate, your luck bar goes up. Once you reach the maximum, the next spin is <b>100% guaranteed</b> to be a country you don't have yet!"
    },
    "step5": {
      "title": "🛒 Shop & Economy",
      "desc": "Don't worry about duplicates. Each repeated country gives you <b>coins</b> (depending on its rarity). You can use coins in this Store to <b>buy missing countries</b> or <b>Upgrades</b> (like Autoclicker or multipliers)."
    },
    "step6": {
      "title": "📚 Your Collection",
      "desc": "In this tab you can see all the countries you have already taken and how many you have left. You can click on them to see details and curiosities."
    },
    "step7": {
      "title": "🏆 Achievements",
      "desc": "Complete continents, form groups of specific countries (like the CPLP or European Union) and achieve goals to unlock these unique achievements."
    },
    "step8": {
      "title": "🌍 Ready to Play!",
      "desc": "Now it's up to you! Good luck on your journey to unlock the entire world, one birth at a time."
    }
  }
