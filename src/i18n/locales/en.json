      "close": "Close"
    },
    "privacy": {
      "title": "Privacy and Terms",
      "project": "This is a free, non-commercial educational and entertainment project.",
      "noData": "No personal data is collected.",
      "localStorage": "Your progress is stored exclusively in your device's local storage (localStorage). No information is sent to servers.",
      "noCookies": "This game does not use cookies. Only localStorage is used to save your preferences and progress.",
      "noTracking": "There are no analytics, tracking, advertising, or third-party systems.",
      "borders": "Geographical, demographic, and border data are estimates and may be incomplete or outdated. This project takes no political stance on borders, territories, or state recognition.",
