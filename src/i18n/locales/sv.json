  "tour": {
    "skip": "Hoppa över självstudiekursen",
    "next": "Nästa ➔",
    "prev": "← Anterior",
    "done": "Avsluta ✓",
    "progress": "Steg {{current}} av {{total}}",
    "step1": {
      "title": "👋 Välkommen till WorldDex!",
      "desc": "Här kommer du att samla alla länder i världen genom dragningar baserat på den sanna globala födelsetalen. Låt oss se hur det fungerar?"
    },
    "step2": {
      "title": "🎲 Rolar Pelo Mundo",
      "desc": "Clica neste botão (ou pressiona Espaço) para girares. A probabilidade de te calhar um país é <b>exatamente igual à probabilidade de nasceres lá</b> no mundo real. Quanto mais nascimentos, mais comum!"
    },
    "step3": {
      "title": "🗺️ Din karta",
      "desc": "När du låser upp ett nytt land kommer det att målas på kartan med färgen av dess sällsynthet (vanligt, ovanligt, sällsynt, episk eller legendarisk)."
    },
    "step4": {
      "title": "💖 Syndsystem",
      "desc": "Varje gång du får en dubblett går din lyckostapel upp. När du når maxgränsen är nästa snurr <b>100 % garanterad</b> ett land du inte har ännu!"
    },
    "step5": {
      "title": "🛒 Loja & Economia",
      "desc": "Não te preocupes com os duplicados. Cada país repetido dá-te <b>moedas</b> (dependendo da sua raridade). Podes usar moedas nesta Loja para <b>comprar países em falta</b> ou <b>Upgrades</b> (como o Autoclicker ou multiplicadores)."
    },
    "step6": {
      "title": "📚 Din samling",
      "desc": "På den här fliken kan du se alla länder du redan har tagit och hur många du har kvar. Du kan klicka på dem för att se detaljer och kuriosa."
    },
    "step7": {
      "title": "🏆 Conquistas",
      "desc": "Komplettera kontinenter, bilda grupper av specifika länder (som CPLP eller Europeiska unionen) och uppnå mål för att låsa upp dessa unika prestationer."
    },
    "step8": {
      "title": "🌍 Redo att spela!",
      "desc": "Nu är det upp till dig! Lycka till på din resa för att låsa upp hela världen, en födelse i taget."
    }
  },
