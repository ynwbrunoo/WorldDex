  "tour": {
    "skip": "Pular Tutorial",
    "next": "Próximo ➔",
    "prev": "⬅ Anterior",
    "done": "Terminar ✓",
    "progress": "Passo {{current}} de {{total}}",
    "step1": {
      "title": "👋 Bem-vindo ao WorldDex!",
      "desc": "Aqui vais colecionar todos os países do mundo através de sorteios baseados na verdadeira taxa de natalidade global. Vamos ver como funciona?"
    },
    "step2": {
      "title": "🎲 Rolar Pelo Mundo",
      "desc": "Pritisnite ovaj gumb (ili pritisnite Space) za okretanje. Vjerojatnost da ćete sletjeti u neku zemlju je <b>točno ista kao i vjerojatnost da ćete se tamo roditi</b> u stvarnom svijetu. Što više poroda, to češće!"
    },
    "step3": {
      "title": "🗺️ Vaša karta",
      "desc": "Sempre que desbloqueares um país novo, ele será pintado no mapa com a cor da sua raridade (Comum, Incomum, Raro, Épico ou Lendário)."
    },
    "step4": {
      "title": "💖 Sustav sažaljenja",
      "desc": "Cada vez que te calha um duplicado, a barra de sorte sobe. Quando chegar ao máximo, o próximo giro é <b>100% garantido</b> de ser um país que ainda não tens!"
    },
    "step5": {
      "title": "🛒 Loja & Economia",
      "desc": "Ne brinite o duplikatima. Svaka ponovljena zemlja vam daje <b>kovanice</b> (ovisno o svojoj rijetkosti). Novčiće u ovoj trgovini možete koristiti za <b>kupnju zemalja koje nedostaju</b> ili <b>nadogradnje</b> (poput automatskog klikanja ili množitelja)."
    },
    "step6": {
      "title": "📚 Vaša kolekcija",
      "desc": "U ovoj kartici možete vidjeti sve zemlje koje ste već posjetili i koliko vam je ostalo. Možete kliknuti na njih kako biste vidjeli detalje i zanimljivosti."
    },
    "step7": {
      "title": "🏆 Postignuća",
      "desc": "Dovršite kontinente, formirajte grupe određenih zemalja (poput CPLP-a ili Europske unije) i postignite ciljeve kako biste otključali ova jedinstvena postignuća."
    },
    "step8": {
      "title": "🌍 Spremni za igru!",
      "desc": "Sada je na vama! Sretno na vašem putu otključavanja cijelog svijeta, jedno po jedno rođenje."
    }
  }
