  "pity": {
    "title": "Zbrana sreča",
    "guaranteedTitle": "Nova država zagotovljena!",
    "ready": "Naslednja rolada bo čarobna!"
  },
  "tour": {
    "skip": "Pular Tutorial",
    "next": "Próximo ➔",
    "prev": "← Anterior",
    "done": "Terminar ✓",
    "progress": "Korak {{current}} od {{total}}",
    "step1": {
      "title": "👋 Dobrodošli v WorldDex!",
      "desc": "Aqui vais colecionar todos os países do mundo através de sorteios baseados na verdadeira taxa de natalidade global. Vamos ver como funciona?"
    },
    "step2": {
      "title": "🎲 Pomikajte se po svetu",
      "desc": "Clica neste botão (ou pressiona Espaço) para girares. A probabilidade de te calhar um país é <b>exatamente igual à probabilidade de nasceres lá</b> no mundo real. Quanto mais nascimentos, mais comum!"
    },
    "step3": {
      "title": "🗺️ Vaš zemljevid",
      "desc": "Kadar koli odklenete novo državo, bo na zemljevidu pobarvana z barvo svoje redkosti (običajna, neobičajna, redka, epska ali legendarna)."
    },
    "step4": {
      "title": "💖 Sistema de Pity",
      "desc": "Vsakič, ko dobite dvojnik, se vaša vrstica sreče dvigne. Ko dosežete največjo vrednost, je <b>100 % zajamčeno</b>, da bo naslednji vrtljaj država, ki je še nimate!"
    },
    "step5": {
      "title": "🛒 Trgovina & Ekonomija",
      "desc": "Ne skrbite za dvojnike. Vsaka ponovljena država vam podari <b>kovance</b> (odvisno od redkosti). V tej trgovini lahko uporabite kovance za <b>nakup manjkajočih držav</b> ali <b>nadgradnje</b> (kot je samodejni klik ali množilniki)."
    },
    "step6": {
      "title": "📚 A Tua Coleção",
      "desc": "V tem zavihku si lahko ogledate vse države, ki ste jih že obiskali, in koliko jih je še ostalo. Lahko jih kliknete za ogled podrobnosti in zanimivosti."
    },
    "step7": {
      "title": "🏆 Conquistas",
      "desc": "Dokončajte celine, oblikujte skupine določenih držav (kot je CPLP ali Evropska unija) in dosegajte cilje, da odklenete te edinstvene dosežke."
    },
    "step8": {
      "title": "🌍 Pripravljen za igro!",
      "desc": "Zdaj je odvisno od vas! Vso srečo na vaši poti, da odklenete ves svet, eno rojstvo naenkrat."
    }
  },
