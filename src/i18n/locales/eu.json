  "pity": {
    "title": "Zorte metatua",
    "guaranteedTitle": "Herrialde Berria Bermatuta!",
    "ready": "Hurrengo jaurtiketa magikoa izango da!"
  },
  "tour": {
    "skip": "Pular Tutorial",
    "next": "Hurrengoa ➔",
    "prev": "← Anterior",
    "done": "Amaitu ✓",
    "progress": "{{current}}/{{total}} urratsa",
    "step1": {
      "title": "👋 Bem-vindo ao WorldDex!",
      "desc": "Hemen munduko herrialde guztiak bilduko dituzu benetako jaiotza-tasan oinarritutako zozketa bidez. Ea nola funtzionatzen duen?"
    },
    "step2": {
      "title": "🎲 Rolar Pelo Mundo",
      "desc": "Egin klik botoi honetan (edo sakatu Zuriunean) biratzeko. Herrialde batean lurreratzeko probabilitatea mundu errealean <b>bertan jaiotzeko probabilitatearen berdina da</b>. Zenbat eta jaiotza gehiago, orduan eta ohikoagoa!"
    },
    "step3": {
      "title": "🗺️ O Teu Mapa",
      "desc": "Herrialde berri bat desblokeatzen duzun bakoitzean, bere arraroaren kolorearekin margotuko da mapan (Arrunta, Ezohikoa, Arraroa, Epikoa edo Kondairazkoa)."
    },
    "step4": {
      "title": "💖 Pena Sistema",
      "desc": "Bikoiztu bat lortzen duzun bakoitzean, zure zorte barra igotzen da. Gehienera iristen zarenean, hurrengo bira <b>% 100 bermatuta</b> dago oraindik ez duzun herrialdea izango dela!"
    },
    "step5": {
      "title": "🛒 Denda eta Ekonomia",
      "desc": "Ez kezkatu bikoiztuengatik. Errepikatzen diren herrialde bakoitzak <b>txanponak</b> ematen dizkizu (bere bitxikeriaren arabera). Denda honetako txanponak erabil ditzakezu <b>faltako herrialdeak</b> edo <b>Bertsioak</b> erosteko (Autoclicker edo biderkatzaileak adibidez)."
    },
    "step6": {
      "title": "📚 Zure bilduma",
      "desc": "Fitxa honetan dagoeneko hartu dituzun herrialde guztiak eta zenbat geratzen zaren ikus ditzakezu. Haien gainean klik egin dezakezu xehetasunak eta bitxikeriak ikusteko."
    },
    "step7": {
      "title": "🏆 Lorpenak",
      "desc": "Osatu kontinenteak, osatu herrialde espezifikoen taldeak (adibidez, CPLP edo Europar Batasuna) eta lortu helburuak lorpen berezi horiek desblokeatzeko."
    },
    "step8": {
      "title": "🌍 Jolasteko prest!",
      "desc": "Orain zure esku dago! Zorte on mundu osoa desblokeatzeko bidaian, jaiotza bat aldi berean."
    }
  }
