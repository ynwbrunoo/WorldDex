  "pity": {
    "title": "Akkumuleret held",
    "guaranteedTitle": "Nyt land garanteret!",
    "ready": "Det næste kast bliver magisk!"
  },
  "tour": {
    "skip": "Spring selvstudie over",
    "next": "Næste ➔",
    "prev": "← Tidligere",
    "done": "Afslut ✓",
    "progress": "Trin {{current}} af {{total}}",
    "step1": {
      "title": "👋 Velkommen til WorldDex!",
      "desc": "Her vil du samle alle lande i verden gennem lodtrækninger baseret på den sande globale fødselsrate. Lad os se, hvordan det virker?"
    },
    "step2": {
      "title": "🎲 Rul jorden rundt",
      "desc": "Klik på denne knap (eller tryk på mellemrumstasten) for at dreje. Sandsynligheden for at lande på et land er <b>nøjagtig den samme som sandsynligheden for at blive født der</b> i den virkelige verden. Jo flere fødsler, jo mere almindelige!"
    },
    "step3": {
      "title": "🗺️ Dit kort",
      "desc": "Hver gang du låser et nyt land op, vil det blive malet på kortet med farven af ​​dets sjældenhed (almindelig, usædvanlig, sjælden, episk eller legendarisk)."
    },
    "step4": {
      "title": "💖 Skadesystem",
      "desc": "Hver gang du får en duplikat, stiger din lykkebar. Når du når maksimum, er det næste spin <b>100 % garanteret</b> at være et land, du ikke har endnu!"
    },
    "step5": {
      "title": "🛒 Butik og økonomi",
      "desc": "Du skal ikke bekymre dig om dubletter. Hvert gentaget land giver dig <b>mønter</b> (afhængigt af dets sjældenhed). Du kan bruge mønter i denne butik til at <b>købe manglende lande</b> eller <b>opgraderinger</b> (såsom Autoclicker eller multiplikatorer)."
    },
    "step6": {
      "title": "📚 Din samling",
      "desc": "På denne fane kan du se alle de lande, du allerede har taget, og hvor mange du har tilbage. Du kan klikke på dem for at se detaljer og kuriositeter."
    },
    "step7": {
      "title": "🏆 Præstationer",
      "desc": "Fuldfør kontinenter, form grupper af specifikke lande (som CPLP eller Den Europæiske Union) og opnå mål for at låse op for disse unikke præstationer."
    },
    "step8": {
      "title": "🌍 Klar til at spille!",
      "desc": "Nu er det op til dig! Held og lykke på din rejse for at låse op for hele verden, én fødsel ad gangen."
    }
  },
