  "pity": {
    "title": "Chance Accumulée",
    "guaranteedTitle": "Nouveau Pays Garanti !",
    "ready": "Le prochain lancer sera magique !"
  },
  "tour": {
    "skip": "Pular Tutorial",
    "next": "Próximo ➔",
    "prev": "← Anterior",
    "done": "Terminar ✓",
    "progress": "Passo {{current}} de {{total}}",
    "step1": {
      "title": "👋 Bienvenue sur WorldDex !",
      "desc": "Ici, vous collecterez tous les pays du monde grâce à des tirages basés sur le véritable taux de natalité mondial. Voyons comment ça marche ?"
    },
    "step2": {
      "title": "🎲 Faites défiler le monde",
      "desc": "Cliquez sur ce bouton (ou appuyez sur Espace) pour faire tourner. La probabilité d'atterrir dans un pays est <b>exactement la même que la probabilité d'y naître</b> dans le monde réel. Plus il y a de naissances, plus c'est fréquent !"
    },
    "step3": {
      "title": "🗺️ Votre carte",
      "desc": "Chaque fois que vous débloquerez un nouveau pays, il sera peint sur la carte avec la couleur de sa rareté (commune, peu commune, rare, épique ou légendaire)."
    },
    "step4": {
      "title": "💖 Système de pitié",
      "desc": "Chaque fois que vous obtenez un double, votre barre de chance monte. Une fois que vous avez atteint le maximum, le prochain tour est <b>garanti à 100 %</b> d'être un pays que vous n'avez pas encore !"
    },
    "step5": {
      "title": "🛒 Boutique & Économie",
      "desc": "Ne vous inquiétez pas des doublons. Chaque pays répété vous donne des <b>pièces</b> (en fonction de sa rareté). Vous pouvez utiliser des pièces dans cette boutique pour <b>acheter des pays manquants</b> ou des <b>mises à niveau</b> (comme un autoclicker ou des multiplicateurs)."
    },
    "step6": {
      "title": "📚 Votre collection",
      "desc": "Dans cet onglet, vous pouvez voir tous les pays que vous avez déjà pris et combien il vous en reste. Vous pouvez cliquer dessus pour voir des détails et des curiosités."
    },
    "step7": {
      "title": "🏆 Réalisations",
      "desc": "Complétez des continents, formez des groupes de pays spécifiques (comme la CPLP ou l'Union européenne) et atteignez des objectifs pour débloquer ces réalisations uniques."
    },
    "step8": {
      "title": "🌍 Prêt à jouer !",
      "desc": "Maintenant, c'est à vous de décider ! Bonne chance dans votre voyage pour débloquer le monde entier, une naissance à la fois."
    }
  }
