  "tour": {
    "skip": "Pular Tutorial",
    "next": "Próximo ➔",
    "prev": "⬅ Forrige",
    "done": "Fullfør ✓",
    "progress": "Passo {{current}} de {{total}}",
    "step1": {
      "title": "👋 Velkommen til WorldDex!",
      "desc": "Her vil du samle alle land i verden gjennom trekninger basert på den sanne globale fødselsraten. La oss se hvordan det fungerer?"
    },
    "step2": {
      "title": "🎲 Bla rundt i verden",
      "desc": "Klikk på denne knappen (eller trykk mellomrom) for å snurre. Sannsynligheten for å lande på et land er <b>nøyaktig den samme som sannsynligheten for å bli født der</b> i den virkelige verden. Jo flere fødsler, jo mer vanlig!"
    },
    "step3": {
      "title": "🗺️ Ditt kart",
      "desc": "Hver gang du låser opp et nytt land, vil det bli malt på kartet med fargen av dets sjeldenhet (Common, Uncommon, Rare, Epic eller Legendary)."
    },
    "step4": {
      "title": "💖 Syndsystem",
      "desc": "Hver gang du får en duplikat, går lykkelinjen opp. Når du når maksimum, er det neste spinn <b>100 % garantert</b> å være et land du ikke har ennå!"
    },
    "step5": {
      "title": "🛒 Butikk og økonomi",
      "desc": "Ikke bekymre deg for duplikater. Hvert gjentatte land gir deg <b>mynter</b> (avhengig av dets sjeldenhet). Du kan bruke mynter i denne butikken for å <b>kjøpe manglende land</b> eller <b>oppgraderinger</b> (som Autoclicker eller multiplikatorer)."
    },
    "step6": {
      "title": "📚 Din samling",
      "desc": "I denne fanen kan du se alle landene du allerede har tatt og hvor mange du har igjen. Du kan klikke på dem for å se detaljer og kuriositeter."
    },
    "step7": {
      "title": "🏆 Prestasjoner",
      "desc": "Fullfør kontinenter, form grupper av spesifikke land (som CPLP eller EU) og oppnå mål for å låse opp disse unike prestasjonene."
    },
    "step8": {
      "title": "🌍 Klar til å spille!",
      "desc": "Nå er det opp til deg! Lykke til på reisen din for å låse opp hele verden, én fødsel om gangen."
    }
  }
