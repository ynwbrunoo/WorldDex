    "done": "Pabeigt ✓",
    "progress": "{{current}}. darbība no {{total}}",
    "step1": {
      "title": "👋 Laipni lūdzam WorldDex!",
      "desc": "Šeit jūs apkoposiet visas pasaules valstis, izmantojot izlozes, pamatojoties uz patieso globālo dzimstības līmeni. Apskatīsim, kā tas darbojas?"
    },
    "step2": {
      "title": "🎲 Ritiniet apkārt pasaulei",
      "desc": "Noklikšķiniet uz šīs pogas (vai nospiediet atstarpes taustiņu), lai grieztu. Varbūtība piezemēties kādā valstī ir <b>tieši tāda pati kā varbūtība piedzimt tur</b> reālajā pasaulē. Jo vairāk dzemdību, jo biežāk!"
    },
    "step3": {
      "title": "🗺️ Jūsu karte",
      "desc": "Ikreiz, kad atbloķēsit jaunu valsti, tā tiks uzzīmēta kartē ar tās retuma krāsu (parasta, retāk sastopama, reta, episka vai leģendāra)."
    },
    "step4": {
      "title": "💖 Žēl sistēma",
      "desc": "Katru reizi, kad saņemat dublikātu, jūsu veiksmes josla paaugstinās. Tiklīdz būsit sasniedzis maksimumu, nākamais grieziens ir <b>100% garantēts</b> valstī, kurā vēl nav!"
    },
    "step5": {
      "title": "🛒 Veikals un Ekonomika",
      "desc": "Neuztraucieties par dublikātiem. Katra atkārtota valsts piešķir jums <b>monētas</b> (atkarībā no to retuma). Šajā veikalā varat izmantot monētas, lai <b>iegādātos trūkstošās valstis</b> vai <b>jauninājumus</b> (piemēram, Autoclicker vai reizinātājus)."
    },
    "step6": {
      "title": "📚 Jūsu kolekcija",
      "desc": "Šajā cilnē varat redzēt visas valstis, kuras jau esat apmeklējis, un to, cik daudz esat atstājis. Varat noklikšķināt uz tiem, lai skatītu sīkāku informāciju un intereses."
    },
    "step7": {
      "title": "🏆 Sasniegumi",
      "desc": "Pabeidziet kontinentus, izveidojiet noteiktu valstu grupas (piemēram, CPLP vai Eiropas Savienību) un sasniedziet mērķus, lai atklātu šos unikālos sasniegumus."
    },
    "step8": {
      "title": "🌍 Gatavs spēlēt!",
      "desc": "Tagad tas ir atkarīgs no jums! Veiksmi jūsu ceļojumā, lai atvērtu visu pasauli, pa vienai dzimšanai."
    }
