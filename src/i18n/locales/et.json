  "tour": {
    "skip": "Jäta õpetus vahele",
    "next": "Järgmine ➔",
    "prev": "← Eelmine",
    "done": "Lõpeta ✓",
    "progress": "Samm {{current}}/{{total}}",
    "step1": {
      "title": "👋 Tere tulemast WorldDexi!",
      "desc": "Siin kogute tõelise globaalse sündimuse alusel loosimiste kaudu kõik maailma riigid. Vaatame, kuidas see töötab?"
    },
    "step2": {
      "title": "🎲 Kerige ümber maailma",
      "desc": "Keerutamiseks klõpsake sellel nupul (või vajutage tühikut). Riigile maandumise tõenäosus on <b>täpselt sama kui tõenäosus seal sündida</b> pärismaailmas. Mida rohkem sünnitusi, seda tavalisem!"
    },
    "step3": {
      "title": "🗺️ Teie kaart",
      "desc": "Iga kord, kui avate mõne uue riigi, maalitakse see kaardile selle harulduse värviga (tavaline, ebatavaline, haruldane, eepiline või legendaarne)."
    },
    "step4": {
      "title": "💖 Kahju süsteem",
      "desc": "Iga kord, kui saate duplikaadi, tõuseb teie õnneriba. Kui saavutate maksimumi, on järgmine keerutus <b>100% garanteeritud</b> riigis, kus teil veel ei ole!"
    },
    "step5": {
      "title": "🛒 Pood & Economy",
      "desc": "Ärge muretsege duplikaatide pärast. Iga korduv riik annab teile <b>münte</b> (olenevalt nende haruldusest). Saate selles poes münte kasutada <b>puuduvate riikide ostmiseks</b> või <b>täiendusteks</b> (nt Autoclicker või kordistajad)."
    },
    "step6": {
      "title": "📚 Teie kollektsioon",
      "desc": "Sellel vahekaardil näete kõiki riike, mille olete juba külastanud, ja kui palju riike olete lahkunud. Üksikasjade ja uudishimude vaatamiseks võite neil klõpsata."
    },
    "step7": {
      "title": "🏆 Saavutused",
      "desc": "Lõpetage mandrid, moodustage konkreetsete riikide rühmad (nagu CPLP või Euroopa Liit) ja saavutage eesmärgid nende ainulaadsete saavutuste avamiseks."
    },
    "step8": {
      "title": "🌍 Mängimiseks valmis!",
      "desc": "Nüüd on see teie otsustada! Edu teekonnal, et avada kogu maailm, üks sünnitus korraga."
    }
