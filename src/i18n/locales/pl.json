  },
  "tour": {
    "skip": "Pomiń samouczek",
    "next": "Dalej ➔",
    "prev": "← Poprzedni",
    "done": "Zakończ ✓",
    "progress": "Krok {{current}} z {{total}}",
    "step1": {
      "title": "👋 Witamy w WorldDex!",
      "desc": "Tutaj zbierzesz wszystkie kraje na świecie poprzez losowanie w oparciu o prawdziwy globalny współczynnik urodzeń. Zobaczmy jak to działa?"
    },
    "step2": {
      "title": "🎲 Przewijaj dookoła świata",
      "desc": "Kliknij ten przycisk (lub naciśnij spację), aby obrócić. Prawdopodobieństwo wylądowania w danym kraju jest <b>dokładnie takie samo, jak prawdopodobieństwo urodzenia się w nim</b> w prawdziwym świecie. Im więcej porodów, tym częściej!"
    },
    "step3": {
      "title": "🗺️ Twoja mapa",
      "desc": "Za każdym razem, gdy odblokujesz nowy kraj, zostanie on pomalowany na mapie kolorem odpowiadającym jego rzadkości (pospolity, niepospolity, rzadki, epicki lub legendarny)."
    },
    "step4": {
      "title": "💖 System litości",
      "desc": "Za każdym razem, gdy zdobędziesz duplikat, Twój pasek szczęścia rośnie. Gdy osiągniesz maksimum, przy następnym spinie <b>100% gwarancji</b> będzie to kraj, którego jeszcze nie masz!"
    },
    "step5": {
      "title": "🛒 Sklep i gospodarka",
      "desc": "Nie martw się o duplikaty. Każdy powtarzający się kraj daje <b>monety</b> (w zależności od jego rzadkości). Możesz używać monet w tym Sklepie do <b>kupowania brakujących krajów</b> lub <b>ulepszeń</b> (takich jak Autoclicker lub mnożniki)."
    },
    "step6": {
      "title": "📚 Twoja kolekcja",
      "desc": "W tej zakładce możesz zobaczyć wszystkie kraje, które już wykorzystałeś i ile jeszcze Ci zostało. Można na nie kliknąć, żeby zobaczyć szczegóły i ciekawostki."
    },
    "step7": {
      "title": "🏆 Osiągnięcia",
      "desc": "Kompletuj kontynenty, twórz grupy określonych krajów (takich jak CPLP lub Unia Europejska) i osiągaj cele, aby odblokować te wyjątkowe osiągnięcia."
    },
    "step8": {
      "title": "🌍 Gotowy do gry!",
      "desc": "Teraz to zależy od Ciebie! Powodzenia na Twojej drodze do odblokowania całego świata, jedno narodziny na raz."
    }
  }
